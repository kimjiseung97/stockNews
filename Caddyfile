{$DOMAIN} {
    encode gzip zstd
    reverse_proxy app:8080
}

# stockNewsAdmin - 같은 stocknews_default 네트워크에 붙은 컨테이너를 이름으로 찾아간다.
# app/db 컨테이너와는 무관하며, 이 블록만 재배포/재기동 대상이다.
{$ADMIN_DOMAIN} {
    encode gzip zstd
    reverse_proxy stocknewsadmin-app-1:8081
}

# n8n - 별도 compose(~/n8n)로 뜨는 컨테이너. 이 블록만 재기동 대상이다.
# DOMAIN/ADMIN_DOMAIN 과 달리 시크릿(GitHub Secrets)이 아니라 직접 적는다 —
# 이 레포의 배포 워크플로우가 .env 를 재생성하므로 새 변수를 쓰려면 workflow 까지 고쳐야 한다.
n8n.stocknews-home.duckdns.org {
    encode gzip zstd
    reverse_proxy n8n:5678
}

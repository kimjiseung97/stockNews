DB_HOST=jiseung-jiseungmysql.g.aivencloud.com
DB_PORT=14822
DB_NAME=stock
DB_USERNAME=avnadmin
DB_PASSWORD=changeme

MAIL_HOST=smtp.naver.com
MAIL_PORT=587
MAIL_USERNAME=changeme
MAIL_PASSWORD=changeme
MAIL_FROM_NAME=stockNews

NAVER_CLIENT_ID=changeme
NAVER_CLIENT_SECRET=changeme

TOSS_CLIENT_ID=changeme
TOSS_CLIENT_SECRET=changeme

NVIDIA_API_KEY=changeme

FINNHUB_API_KEY=changeme

CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

DOMAIN=api.yourdomain.com

IMAGE_TAG=latest
SCHEDULER_ENABLED=true

# IP 단위 API 요청 제한. 정상 사용자가 막히는 오탐이 생기면 RATE_LIMIT_ENABLED=false로 즉시 끌 수 있다.
# RATE_LIMIT_CAPACITY: RATE_LIMIT_REFILL_PERIOD 동안 IP 하나가 쓸 수 있는 요청 수
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PERIOD=1m
# 앱 앞의 신뢰 프록시 수(Caddy 1대). X-Forwarded-For를 뒤에서 몇 번째까지 믿을지를 정한다.
# 프록시가 없는 환경은 반드시 0 - 아니면 누구나 헤더를 붙여 제한을 우회할 수 있다.
RATE_LIMIT_TRUSTED_PROXY_COUNT=1

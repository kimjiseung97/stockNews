server:
  servlet:
    session:
      timeout: 30m

spring:
  datasource:
    url: jdbc:mariadb://<host>:<port>/<db>?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: <db-username>
    password: <db-password>
    driver-class-name: org.mariadb.jdbc.Driver
    hikari:
      # 뉴스 발송 배치는 워커 스레드(news.dispatch.thread-pool-size, 기본 8)마다 청크 트랜잭션 커넥션을 잡은 채
      # 발송 로그용 REQUIRES_NEW 커넥션을 하나 더 요구한다. 기본값 10이면 모든 워커가 두 번째 커넥션을
      # 서로 기다리다 멈출 수 있어 워커 수의 2배 + 여유만큼 잡는다.
      maximum-pool-size: ${DB_POOL_SIZE:20}

  task:
    scheduling:
      pool:
        size: 8

  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: update
      naming:
        physical-strategy: org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
    show-sql: false
    properties:
      hibernate:
        format_sql: true

  mail:
    host: smtp.naver.com
    port: 587
    username: <mail-username>
    password: <mail-password>
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
          connectiontimeout: 10000
          timeout: 30000
          writetimeout: 30000

mail:
  from-name: testMail

sec:
  tickers-url: https://www.sec.gov/files/company_tickers.json
  user-agent: stockNews-dev <your-email>

nasdaq:
  listed-url: https://www.nasdaqtrader.com/dynamic/SymDir/nasdaqlisted.txt
  other-listed-url: https://www.nasdaqtrader.com/dynamic/SymDir/otherlisted.txt


# toss.client-id/client-secret은 비워두면 됨(TossStockClient가 API 호출 없이 빈 목록 반환) -
# 로컬에서 토스 연동을 직접 테스트해야 할 때만 아래 주석 해제해서 채울 것. 로컬 yml에 실제 크레덴셜을 두는 게
# GitHub Secrets보다 위험하다는 판단으로 기본은 비활성화.
# toss:
#   base-url: https://openapi.tossinvest.com
#   client-id: <toss-client-id>
#   client-secret: <toss-client-secret>

stock:
  seed:
    batch-size: 300
    cron: "0 */2 * * * *"
  theme-enrich:
    batch-size: 300
    cron: "0 */2 * * * *"
  korean-name-enrich:
    cron: "0 */2 * * * *"
  english-name-enrich:
    batch-size: 100
    cron: "0 */2 * * * *"
  detail-enrich:
    batch-size: 20
    cron: "0 */2 * * * *"
  delist-check:
    cron: "*/5 * * * * *"
  batch-watchdog:
    cron: "0 */10 * * * *"
    stale-minutes: 30
  batch-history-cleanup:
    cron: "*/5 * * * * *"
    retention-days: 30
  news-collect:
    cron: "0 0 6 * * *"
    thread-pool-size: 4
  news-cleanup:
    cron: "0 30 6 * * *"
    retention-days: 7

news:
  # TB_STOCK_NEWS 미임베딩 건을 임베딩 서비스로 넘기는 배치.
  # 뉴스 수집(형제 Node 프로젝트)이 돌고 난 뒤 쌓인 만큼 따라가면 되므로 10분 주기면 충분하다.
  embedding:
    cron: "0 */10 * * * *"
    # 임베딩 서비스 주소. 배포에서는 stocknews_internal 망의 컨테이너 alias를 쓴다
    # (무인증 API라 외부로 노출된 주소를 넣지 말 것).
    # 로컬은 embedding-service를 직접 띄우고(기본 8000) 붙는다. 안 띄웠으면 배치가 매 주기 실패하므로
    # 임베딩을 안 볼 때는 cron을 길게 두거나 SCHEDULER_ENABLED=false로 스케줄러 전체를 끌 것.
    base-url: http://localhost:8000
    # 한 요청에 담는 뉴스 건수. 서비스 상한은 50이지만, 실패 시 묶음 전체를 다시 보내야 해서 작게 잡는다.
    batch-size: 10
    # 한 번 트리거될 때 처리할 최대 묶음 수. 밀린 건이 많아도 한 실행이 무한정 길어지지 않게 하는 상한.
    max-batches-per-run: 20
    connect-timeout-ms: 5000
    # CPU 추론이라 10건 묶음이 수십 초 걸릴 수 있다. 짧으면 서비스는 처리했는데 호출 측만 실패로 보고
    # 같은 묶음을 계속 재전송하게 된다.
    read-timeout-ms: 180000

  # 챗봇이 질문과 의미가 가까운 뉴스를 찾는 검색. 임베딩과 pgvector 조회는 파이썬
  # embedding-service가 하고, 이 앱은 질문 문장을 넘기고 기사 목록을 받는다.
  vector-search:
    # 적재(위 embedding 배치)와 같은 서비스다. 무인증 API라 내부망 주소를 쓸 것.
    base-url: http://localhost:8000
    # 프롬프트에 넣을 뉴스 기사 건수. 늘리면 근거는 늘지만 LLM 토큰과 응답 지연이 함께 늘어난다.
    article-limit: 3
    # 사용자가 화면 앞에서 기다리는 경로라 적재 배치(3분)와 달리 짧게 잡는다.
    # 늦으면 뉴스 근거를 포기하고 답변을 진행하는 편이 낫다.
    connect-timeout-ms: 2000
    read-timeout-ms: 5000

  dispatch:
    # 유저별 발송시간대(TB_USER_MAIL_DISPATCH_SETTING, 30분 단위)와 정확히 일치하는지 매번 검사하므로
    # 30분마다 돌아야 한다.
    cron: "0 0,30 * * * *"
    thread-pool-size: 4
    max-articles-per-stock: 1

verification:
  cleanup:
    cron: "0 0 * * * *"

finnhub:
  base-url: https://finnhub.io
  api-key: <finnhub-api-key>
  lookback-days: 3
  cache-ttl-minutes: 60
  max-articles-per-ticker: 1

naver:
  news:
    client-id: <naver-client-id>
    client-secret: <naver-client-secret>
    max-articles-per-query: 1
    cache-ttl-minutes: 60

llm:
  provider: nvidia   # nvidia | anthropic | openai

anthropic:
  api:
    key: your-anthropic-api-key
    model: claude-opus-5
    effort: low

openai:
  api:
    key: your-openai-api-key
    model: gpt-5-mini
    reasoning-effort: low

nvidia:
  api:
    base-url: https://integrate.api.nvidia.com/v1
    key: <nvidia-api-key>
    model: moonshotai/kimi-k3
    max-tokens: 1024
    top-p: 0.95
    connect-timeout-ms: 10000
    read-timeout-ms: 120000
    # 답을 내기 전에 태우는 추론 토큰 분량(low/medium/high). gpt-oss 계열 전용 파라미터다.
    # 안 보내면 모델 기본값으로 길게 추론한다 - 실측에서 답변 하나가 41초였고 그 대부분이 추론이었다.
    # 비우면 파라미터를 보내지 않아 예전 동작으로 돌아간다(재배포 없이 끌 수 있게 env로 뺐다).
    reasoning-effort: low
    # reasoning-effort를 실어 보낼 모델. 모르는 파라미터를 400으로 거절하는 모델이 있고 400은
    # 폴백 대상이 아니라 그대로 실패하므로, 지원이 확인된 모델만 적는다.
    reasoning-effort-models: openai/gpt-oss-20b

# 어드민(TB_PROMPT)에 등록된 LLM 프롬프트를 다시 읽기까지의 캐시 시간. 어드민 수정은 최대 이 시간 뒤에 반영된다.
prompt:
  cache-ttl-seconds: 60

auth:
  verification:
    code-length: 6
    expiry-minutes: 10
    max-requests: 9999
    max-attempts: 9999

cors:
  # 프론트 Vite dev 서버 주소. npm run dev 기동 시 실제로 뜨는 Local 주소(포트가 다르면 그 값)를 넣을 것
  allowed-origins: http://localhost:5173

# IP 단위 API 요청 제한. 로컬은 개발 중 새로고침만으로도 한도에 닿을 수 있어 넉넉히 둔다.
# 제한 동작 자체를 확인하려면 capacity를 5 정도로 낮추고 같은 API를 연속 호출해볼 것.
rate-limit:
  enabled: true
  capacity: 10000
  refill-period: 1m
  # 로컬은 앞에 프록시가 없다. 0이면 X-Forwarded-For를 무시하고 실제 접속 IP만 본다
  # (프록시가 없는데 헤더를 믿으면 누구나 헤더를 붙여 제한을 우회할 수 있다).
  trusted-proxy-count: 0

logging:
  level:
    org.hibernate: WARN
    org.springframework: WARN
    com.zaxxer.hikari: WARN
    org.mariadb.jdbc: WARN
    org.kjs.stocknews: DEBUG
    # ddl-auto=update가 MariaDB가 지원 안 하는 MySQL 전용 구문(alter ... if exists 등)을 시도해서
    # 매 기동마다 반복 실패하는 무해한 경고 - WARN이어도 남으므로 ERROR로 완전히 죽임
    org.mariadb.jdbc.message.server.ErrorPacket: ERROR
    org.hibernate.tool.schema.internal.ExceptionHandlerLoggedImpl: ERROR
    org.springframework.batch.core.listener.AbstractListenerFactoryBean: ERROR
